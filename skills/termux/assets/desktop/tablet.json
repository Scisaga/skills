{
  "schema": 1,
  "container": "desktop",
  "image": "debian:13",
  "user": "developer",
  "display": ":1",
  "language": "en_US.UTF-8",
  "timezone": "Asia/Shanghai",
  "scale": 2,
  "dpi": 96,
  "font": "Noto Sans CJK SC",
  "font_size": 11,
  "monospace_font": "DejaVu Sans Mono",
  "editor_font_size": 14,
  "scrollbar_size": 6,
  "cursor_size": 48,
  "cursor_theme": "Adwaita",
  "theme": "Greybird-dark",
  "icons": "Papirus-Dark",
  "titlebar_theme": "Tablet-Touch",
  "window_compositing": false,
  "window_vblank_mode": "auto",
  "window_shadows": true,
  "software_rendering": true,
  "gpu_backend": "software",
  "code_angle_backend": "default",
  "browser_backend": "guest",
  "office_backend": "guest",
  "media_backend": "guest",
  "media_hardware_policy": "all",
  "native_browser_icd": "freedreno_icd.aarch64.json",
  "native_browser_present_mode": "default",
  "touch_mode": "preserve",
  "x11_mitshm": true,
  "x11_glamor": false,
  "touch_long_press": false,
  "touch_long_press_ms": 700,
  "touch_long_press_move_px": 24,
  "dock_autohide": true,
  "dock_hide_indicator": true,
  "dock_output": "builtin",
  "applications": ["code", "chromium", "office", "vlc"],
  "code_autostart": true,
  "code_version": "stable",
  "hardware_keyboard": true,
  "android_folder": "Termux"
}
