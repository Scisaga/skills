#!/usr/bin/python3
"""Use the managed hardware decoder and isolated VLC, keeping stock VLC available."""
import json
import os
import sys
from pathlib import Path
sys.path.insert(0, '/usr/local/lib/tablet-desktop')
from ipc import request
from tablet_video_policy import hardware_allowed

try:
    home = Path('/data/data/com.termux/files/home')
    config = json.loads((home / '.config/tablet-desktop/config.json').read_text())
    gpu = json.loads((home / '.config/tablet-desktop/gpu.json').read_text())
    if config.get('media_backend', 'guest') != 'termux-va' or gpu.get('backend') != 'freedreno-kgsl':
        raise RuntimeError('Hardware video requires the reviewed Termux:VA and direct KGSL profile')
    if not hardware_allowed(sys.argv[1:], config.get('media_hardware_policy', 'all')):
        # Keep GPU presentation for formats whose decoder bridge has not passed
        # this device's full-stream test. Do not silently force a broken VA path.
        for key in ('LIBVA_DRIVER_NAME', 'LIBVA_DRIVERS_PATH', 'TERMUX_VA_BRIDGE',
                    'TERMUX_VA_GPU_BACKEND', 'TERMUX_VA_X11_DRI3'):
            os.environ.pop(key, None)
        os.execv('/usr/local/bin/tablet-gpu-run', ['tablet-gpu-run', '/usr/bin/vlc',
                   '--avcodec-hw=none', '--gl=egl_x11', '--vout=gl', *sys.argv[1:]])
    root = Path('/opt/tablet-vlc-va-3.0.24-90')
    executable = root / 'usr/bin/vlc'
    if not executable.is_file():
        raise RuntimeError('Isolated hardware-video VLC bundle is missing; use vlc-tablet-guest')
    state = request('desktop.status')
    request('video.ensure', state['session'])
    os.environ.update(DISPLAY=config['display'], LIBVA_DRIVER_NAME='termuxva', LIBVA_DRIVERS_PATH=gpu['driver_root'] + '/usr/lib/aarch64-linux-gnu/dri',
                      TERMUX_VA_BRIDGE='1', TERMUX_VA_GPU_BACKEND='kgsl', TERMUX_VA_X11_DRI3='1',
                      LD_LIBRARY_PATH=str(root / 'usr/lib/aarch64-linux-gnu'),
                      VLC_PLUGIN_PATH=str(root / 'usr/lib/aarch64-linux-gnu/vlc/plugins'),
                      VLC_DATA_PATH=str(root / 'usr/share/vlc'),
                      QT_SCALE_FACTOR=str(config['scale']), QT_AUTO_SCREEN_SCALE_FACTOR='0', QT_FONT_DPI='96',
                      QT_QPA_PLATFORMTHEME='gtk3', PULSE_SERVER='127.0.0.1',
                      PULSE_COOKIE=str(home / '.config/pulse/cookie'))
    for key in ('QT_OPENGL', 'QT_XCB_GL_INTEGRATION'):
        os.environ.pop(key, None)
    os.execv('/usr/local/bin/tablet-gpu-run', ['tablet-gpu-run', str(executable), '--avcodec-hw=vaapi', '--gl=egl_x11', '--vout=gl', *sys.argv[1:]])
except (OSError, RuntimeError, ValueError, KeyError) as error:
    print(str(error), file=sys.stderr)
    raise SystemExit(1)
