@@ -493,6 +497,41 @@ glamor_add_format(ScreenPtr screen, int depth, CARD32 render_format,
         if (!texture_only) {
             glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_FORMAT, &read_format);
             glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_TYPE, &read_type);
+
+            /* Some Adreno GLES drivers report a zero read type for BGRA,
+             * although EXT_read_format_bgra works. Verify a known pixel in
+             * this disposable 1x1 test FBO before accepting that format. */
+            if (read_type == 0 && read_format == GL_BGRA &&
+                format == GL_BGRA && type == GL_UNSIGNED_BYTE) {
+                GLfloat saved_clear[4];
+                GLboolean saved_mask[4];
+                GLboolean saved_scissor = glIsEnabled(GL_SCISSOR_TEST);
+                GLubyte pixel[4] = { 102, 102, 102, 102 };
+                GLenum read_error;
+
+                glGetFloatv(GL_COLOR_CLEAR_VALUE, saved_clear);
+                glGetBooleanv(GL_COLOR_WRITEMASK, saved_mask);
+                glDisable(GL_SCISSOR_TEST);
+                glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+                glClearColor(17.0f / 255.0f, 33.0f / 255.0f,
+                             49.0f / 255.0f, 1.0f);
+                glClear(GL_COLOR_BUFFER_BIT);
+                glReadPixels(0, 0, 1, 1, GL_BGRA, GL_UNSIGNED_BYTE, pixel);
+                read_error = glGetError();
+                glClearColor(saved_clear[0], saved_clear[1],
+                             saved_clear[2], saved_clear[3]);
+                glColorMask(saved_mask[0], saved_mask[1],
+                            saved_mask[2], saved_mask[3]);
+                if (saved_scissor)
+                    glEnable(GL_SCISSOR_TEST);
+
+                if (read_error == GL_NO_ERROR && pixel[0] == 49 &&
+                    pixel[1] == 33 && pixel[2] == 17 && pixel[3] == 255) {
+                    read_type = GL_UNSIGNED_BYTE;
+                    ErrorF("glamor: Verified BGRA/UNSIGNED_BYTE readback "
+                           "despite zero reported type for depth %d.\n", depth);
+                }
+            }
         }
 
         glDeleteTextures(1, &tex);
@@ -782,10 +821,16 @@ glamor_init(ScreenPtr screen, unsigned int flags)
         epoxy_has_gl_extension("GL_EXT_map_buffer_range");
     glamor_priv->has_buffer_storage =
