+// Only the X server thread reads or changes this queue.
+struct PendingKeyboardEvent {
+    lorieEvent event;
+    PendingKeyboardEvent* next;
+};
+
+static PendingKeyboardEvent *keyboardHead = nullptr, *keyboardTail = nullptr;
+static OsTimerPtr keyboardTimer = nullptr;
+static uintptr_t keyboardGeneration = 0;
+static bool keyboardWaiting = false;
+static bool unicodeMappingPrepared = false;
+static constexpr CARD32 unicodeGraceMs = 30;
+
+static Bool resumeKeyboardEvents(ClientPtr, void *closure);
+
+static CARD32 keyboardDelayExpired(OsTimerPtr, CARD32, void*) {
+    // Timer callbacks may hold the input lock. Resume in normal server work.
+    if (!QueueWorkProc(resumeKeyboardEvents, nullptr, (void*) keyboardGeneration))
+        return unicodeGraceMs;
+    lorieWakeServer();
+    return 0;
+}
+
+static bool waitForUnicodeClients() {
+    keyboardTimer = TimerSet(keyboardTimer, 0, unicodeGraceMs, keyboardDelayExpired, nullptr);
+    keyboardWaiting = keyboardTimer != nullptr;
+    return keyboardWaiting;
+}
+
+static void drainKeyboardEvents() {
+    while (keyboardHead) {
+        const lorieEvent& event = keyboardHead->event;
+        bool unicode = event.type == EVENT_UNICODE;
+        bool nonAscii = unicode && event.unicode.code >= 128;
+        if (unicode) {
+            auto keysym = ucs2keysym((long) event.unicode.code);
+            if (nonAscii && !unicodeMappingPrepared && loriePrepareKeysym(keysym)) {
+                // Let clients read the changed map before its first key event.
+                unicodeMappingPrepared = true;
+                if (waitForUnicodeClients())
+                    return;
+            }
+
+            lorieKeysymKeyboardEvent(keysym, TRUE);
+            lorieKeysymKeyboardEvent(keysym, FALSE);
+        } else if (event.type == EVENT_KEY) {
+            const auto keycode = event.key.key;
+            if (keycode > 255) {
+                for (size_t i = 0; i < lorieExtendedKeysCount; i++)
+                    if (lorieExtendedKeys[i].code == keycode - 8)
+                        lorieKeysymKeyboardEvent(lorieExtendedKeys[i].keysym, event.key.state);
+            } else {
+                QueueKeyboardEvents(lorieKeyboard, event.key.state ? KeyPress : KeyRelease, keycode);
+                mieqProcessInputEvents();
+            }
+        } else if (event.type == EVENT_LOCK_KEYS_STATE) {
+            lorieSyncLockKeysState(event.lockKeysState.state);
+        } else if (event.type == EVENT_SYNC) {
+            // Confirm the barrier only after preceding keyboard events and mieq.
+            mieqProcessInputEvents();
+            lorieSendSyncReply(event.sync.serial);
+        }
+
+        auto* delivered = keyboardHead;
+        keyboardHead = delivered->next;
+        if (!keyboardHead)
+            keyboardTail = nullptr;
+        free(delivered);
+        unicodeMappingPrepared = false;
+
+        // Preserve the mapping until clients have processed the key event.
+        if (nonAscii && waitForUnicodeClients())
+            return;
+    }
+}
+
+static Bool resumeKeyboardEvents(ClientPtr, void *closure) {
+    if ((uintptr_t) closure == keyboardGeneration) {
+        keyboardWaiting = false;
+        drainKeyboardEvents();
+    }
+    return TRUE;
+}
+
+static Bool appendKeyboardEvent(ClientPtr, void *closure) {
+    auto* pending = (PendingKeyboardEvent*) closure;
+    if (keyboardTail)
+        keyboardTail->next = pending;
+    else
+        keyboardHead = pending;
+    keyboardTail = pending;
+    if (!keyboardWaiting)
+        drainKeyboardEvents();
+    return TRUE;
+}
+
+static void queueKeyboardEvent(const lorieEvent& event) {
+    auto* pending = (PendingKeyboardEvent*) calloc(1, sizeof(PendingKeyboardEvent));
+    if (!pending)
+        return;
+    pending->event = event;
+    if (!QueueWorkProc(appendKeyboardEvent, nullptr, pending)) {
+        free(pending);
+        return;
+    }
+    lorieWakeServer();
+}
+
+static void resetKeyboardEvents() {
+    ++keyboardGeneration;
+    TimerCancel(keyboardTimer);
+    while (keyboardHead) {
+        auto* pending = keyboardHead;
+        keyboardHead = pending->next;
+        free(pending);
+    }
+    keyboardTail = nullptr;
+    keyboardWaiting = false;
+    unicodeMappingPrepared = false;
+    lorieReleaseAllKeys();
+}
