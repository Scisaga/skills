@@ -178,4 +178,38 @@ public class CmdEntryPoint extends ICmdEntryInterface.Stub {
     }

+    @Override
+    public String editorSessionToken() {
+        return EditorTaskClose.termuxSessionToken();
+    }
+
+    @Override
+    public boolean closeEditor(String sessionToken) {
+        return EditorTaskClose.closeInTermux(intent.getStringExtra(EXTRA_DOCUMENT_TAG), sessionToken);
+    }
+
+    private IBinder editorHost;
+
+    @Override
+    public void watchEditorHost(IBinder lifetime) {
+        if (lifetime == null || EditorTaskClose.termuxSessionToken() == null)
+            return;
+        handler.post(() -> {
+            if (editorHost == lifetime)
+                return;
+            editorHost = lifetime;
+            IBinder.DeathRecipient death = () -> handler.postDelayed(() -> {
+                if (editorHost != lifetime)
+                    return;
+                editorHost = null;
+                EditorTaskClose.closeStoppedHost(intent.getStringExtra(EXTRA_DOCUMENT_TAG));
+            }, 700);
+            try {
+                lifetime.linkToDeath(death, 0);
+            } catch (RemoteException alreadyDead) {
+                death.binderDied();
+            }
+        });
+    }
+
     public native boolean start(String[] args);
     public native void windowChanged(Surface surface);
