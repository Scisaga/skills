{
  "schema_version": 2,
  "name": "{{PROJECT_NAME}}",
  "deliverable": "static_pptx",
  "canvas": {
    "width": 1600,
    "height": 900
  },
  "source": {
    "mode": "uninitialized"
  },
  "content": {
    "page_script": "page-script.md",
    "binding_mode": null,
    "binding_audit": null,
    "page_script_origin_document": null,
    "page_count_at_init": null
  },
  "template": {
    "mode": "generated",
    "source": null,
    "working": "template.pptx",
    "safe_area": {
      "x": 120,
      "y": 150,
      "width": 1360,
      "height": 620
    }
  },
  "visual": {
    "style_preset": "project-default",
    "theme": "light",
    "density": "presentation"
  },
  "paths": {
    "assets": "assets",
    "video": "video",
    "deliverables": "deliverables",
    "voice_profile": "video/voice_profile.json",
    "build_state": "video/build_state.json"
  },
  "outputs": {
    "static_pptx": "deliverables/{{PROJECT_FILE_STEM}}_静态.pptx",
    "animated_pptx": "deliverables/{{DECK_FILE}}",
    "narrated_pptx": "deliverables/{{PROJECT_FILE_STEM}}_自动旁白.pptx",
    "video": "deliverables/{{PROJECT_FILE_STEM}}_自动旁白.mp4"
  }
}
