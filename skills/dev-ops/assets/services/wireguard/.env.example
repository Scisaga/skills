# 服务端：wg-easy v15。首次启动后在 Web UI 的设置向导中配置管理员、
# 公网主机名、WireGuard 地址、DNS、Allowed IPs 和 keepalive。
WG_CONTAINER_NAME=wg-easy
WG_EASY_BASE_IMAGE=ghcr.io/wg-easy/wg-easy:15.4.0
WG_EASY_IMAGE=wg-easy-local:15.4.0-min8
WG_PASSWORD_MIN_LENGTH=8
WG_PORT=61616
# 默认仅允许通过 SSH 隧道访问管理界面：ssh -L 51821:127.0.0.1:51821 <host>
WG_WEB_BIND=127.0.0.1
WG_WEB_PORT=51821
# 仅因 Web UI 绑定在 loopback 并通过 SSH 隧道访问而启用 HTTP。
# 若经 HTTPS 反向代理访问，应改成 false。
WG_UI_INSECURE=true
WG_DOCKER_IPV4_ADDRESS=10.42.42.42
WG_DOCKER_IPV4_SUBNET=10.42.42.0/24
WG_DOCKER_IPV6_ADDRESS=fdcc:ad94:bacf:61a3::2a
WG_DOCKER_IPV6_SUBNET=fdcc:ad94:bacf:61a3::/64
# 让宿主机通过 wg-easy 容器访问 VPN 客户端网段。
WG_HOST_ROUTE_CIDR=10.8.0.0/24
WG_HOST_ROUTE_WAIT_SECONDS=90

# ============ 客户端：client-inst.sh 可选 env 覆盖 ============
# WG_INTERFACE_NAME=wg0
# WG_CONFIG_SOURCE=/path/to/client.conf
# WG_RERESOLVE_CRON=*/2 * * * *
