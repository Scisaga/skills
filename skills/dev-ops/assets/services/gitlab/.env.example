#
# 仅保留 GitLab 本体需要的变量。
# 外层 Nginx、TLS 终止和公网证书由仓库外部管理。
# 脚本会先读取本文件，再允许 .env / .env.local 覆盖。
#

# ============ GitLab ============
GITLAB_IMAGE=gitlab/gitlab-ce:18.10.3-ce.0
GITLAB_CONTAINER_NAME=gitlab
GLOBAL_TIMEZONE=Asia/Shanghai
GITLAB_EXTERNAL_SCHEME=https
GITLAB_EXTERNAL_HOST=gitlab.example.com
GITLAB_EXTERNAL_PORT=443
GITLAB_HTTP_PORT=8080
GITLAB_INTERNAL_HTTP_PORT=80
GITLAB_SSH_PORT=222
GITLAB_DNS_PRIMARY=1.1.1.1
GITLAB_CONFIG_DIR=./config
GITLAB_DATA_DIR=./data
GITLAB_LOG_DIR=./logs
GITLAB_GITDATA_DIR=./gitdata

# ============ SMTP ============
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=example.com
SMTP_TLS=true
SMTP_FROM=noreply@example.com
SMTP_REPLY_TO=noreply@example.com

# ============ Nginx 示例配置 ============
GITLAB_NGINX_HTTP_PORT=80
# 保持 $host 为字面量；非标准 HTTPS 端口时可改成 'https://$host:8443'
GITLAB_NGINX_REDIRECT_BASE='https://$host'
GITLAB_NGINX_SSL_CERT=/etc/ssl/certs/example.fullchain.pem
GITLAB_NGINX_SSL_KEY=/etc/ssl/private/example.key
GITLAB_NGINX_UPSTREAM_HOST=127.0.0.1
GITLAB_NGINX_INSTALL_PATH=/etc/nginx/conf.d/gitlab.conf
