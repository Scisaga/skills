ALIYUN_CLI_PROFILE=default
# 可选：指定网卡后直接读取其稳定公网地址，不再调用外部查 IP 服务。
# 内网 IPv4、临时/失效 IPv6 或多个候选公网地址会报错，不写入 DNS。
DDNS_INTERFACE=
# NAT 场景设 public：指定网卡直连查询出口，禁用代理并强制 IPv4；AAAA 仍从网卡取地址。
DDNS_IPV4_SOURCE=auto
# 可选：直接向指定 DNS 服务器解析查询服务，避免系统 DNS 故障。
DDNS_LOOKUP_DNS_SERVER=
DDNS_LINE=default
DDNS_TTL=600
DDNS_API_TIMEOUT_SECONDS=30
DDNS_API_BACKEND=auto

# 格式：域名|记录类型|RR 列表；多组之间用分号分隔
DDNS_TARGETS='example.com|A|@,git,reg;example.net|AAAA|@'
DDNS_IPV4_LOOKUP_URL=https://ip.3322.net
DDNS_IPV6_LOOKUP_URL=https://6.ipw.cn

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ACME_ACCOUNT_EMAIL=ops@example.com
ACME_CERT_NAME=example.com
ACME_DOMAINS='example.com,*.example.com'
ACME_CERT_DIR=/srv/certs/example.com
ACME_RELOAD_CMD=systemctl reload nginx
