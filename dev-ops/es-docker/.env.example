ES_DOCKER_ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.2.2
ES_DOCKER_ELASTICSEARCH_CONTAINER_NAME=elasticsearch
ES_DOCKER_HTTP_PORT=9200
ES_DOCKER_TRANSPORT_PORT=9300
ES_DOCKER_DATA_DIR_1=/srv/devops/es/data1
ES_DOCKER_DATA_DIR_2=/srv/devops/es/data2
ES_DOCKER_LOG_DIR=./elasticsearch/log
ES_DOCKER_ELASTIC_PASSWORD=
ES_DOCKER_JAVA_OPTS=-Xms6g -Xmx6g
ES_DOCKER_CLUSTER_NAME=es-stack
ES_DOCKER_NODE_NAME=node-1

ES_DOCKER_KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.2.2
ES_DOCKER_KIBANA_CONTAINER_NAME=kibana
ES_DOCKER_KIBANA_PORT=5601
ES_DOCKER_KIBANA_BASE_PATH=/kibana
ES_DOCKER_KIBANA_ENCRYPTION_KEY=change-me-32-chars-minimum-123456

ES_DOCKER_EXPORTER_IMAGE=prometheuscommunity/elasticsearch-exporter:v1.9.0
ES_DOCKER_EXPORTER_CONTAINER_NAME=elasticsearch_exporter
ES_DOCKER_EXPORTER_PORT=9114
