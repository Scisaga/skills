# 服务端：deploy.sh + wg-easy.yaml 会读取这里的变量部署 wg-easy。
# 客户端：client-inst.sh 不依赖这些服务端变量，它需要的是接口名和现成的 .conf 文件。

# ============ 服务端：wg-easy 部署 ============
WG_CONTAINER_NAME=wg-easy
WG_EASY_IMAGE=ghcr.io/wg-easy/wg-easy:14
WG_LANG=en
WG_HOST=vpn.example.com
# Generate with: ./generate-wg-password-hash.sh <plain-password>
WG_PASSWORD_HASH=
WG_PORT=51515
WG_WEB_PORT=51510
WG_DEFAULT_ADDRESS=10.5.0.x
WG_DEFAULT_DNS=8.8.8.8
WG_ALLOWED_IPS=10.0.0.0/24,10.5.0.0/24
WG_PERSISTENT_KEEPALIVE=25
# Optional routing hooks for policy routing / NAT:
WG_POST_UP=
WG_PRE_DOWN=

# ============ 客户端：client-inst.sh 可选 env 覆盖 ============
# WG_INTERFACE_NAME=wg0
# WG_CONFIG_SOURCE=/path/to/client.conf
# WG_RERESOLVE_CRON=*/2 * * * *
