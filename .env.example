# Speech: required only for Azure TTS.
# Create an Azure AI Speech resource, then copy its key and matching region here.
# Never commit a real key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Slides and Speech: auto prefers this self-hosted service, then Azure.
# https://github.com/Scisaga/qwen3-tts-openai
# Service root; a trailing slash or /v1 is accepted. Private IPs bypass proxies.
QWEN_TTS_API_BASE=http://127.0.0.1:12309
# Optional bearer token if the TTS instance enables API_TOKEN. Never commit a real token.
QWEN_TTS_API_KEY=
# Registered local voice ID. configure-voice --provider auto binds this into the project.
# Example instance IDs: xiaochen-hd, xiaoxiao, xiaochen, qwen-en, qwen-zh.
# Confirm with list-voices; old voice_<UUID> IDs are no longer valid on this instance.
QWEN_TTS_VOICE_ID=xiaochen-hd
# Total polling deadline per narration job, including queue time.
QWEN_TTS_TIMEOUT_SECONDS=1800
QWEN_TTS_POLL_INTERVAL_SECONDS=2

# GitLab Issue: only valid when the current repository is hosted on this self-hosted GitLab.
# GITLAB_BASE_URL must be the trusted instance root and must match the current git origin host.
# The project path is always inferred from the current repository origin.
GITLAB_BASE_URL=
# Set a personal, project, or group access token with the required issue API permissions.
# Never commit a real token.
GITLAB_PRIVATE_TOKEN=

# Domain Manager: Gandi v5 and Dynadot RESTful v2 credentials.
# Create tokens with only the scopes needed for the intended domain operations.
# Never commit real credentials.
GANDI_PAT_TOKEN=
DYNADOT_API_KEY=
DYNADOT_API_SECRET=

# Speech: required only for ASR.
# Deploy qwen3-asr-openai as needed: https://github.com/Scisaga/qwen3-asr-openai
# Set this to the reachable service base URL; it is not an API key.
# The current speech client does not use an ASR API key.
QWEN_ASR_API_BASE=http://127.0.0.1:12301

# Optional proxy settings used by subtitle-matcher and other network clients
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1

# WireGuard Easy v15 deployment defaults. Override in
# skills/dev-ops/assets/services/wireguard/.env or .env.local.
WG_CONTAINER_NAME=wg-easy
WG_EASY_BASE_IMAGE=ghcr.io/wg-easy/wg-easy:15.4.0
WG_EASY_IMAGE=wg-easy-local:15.4.0-min8
WG_PASSWORD_MIN_LENGTH=8
WG_PORT=61616
WG_WEB_BIND=127.0.0.1
WG_WEB_PORT=51821
WG_UI_INSECURE=true
WG_DOCKER_IPV4_ADDRESS=10.42.42.42
WG_DOCKER_IPV4_SUBNET=10.42.42.0/24
WG_DOCKER_IPV6_ADDRESS=fdcc:ad94:bacf:61a3::2a
WG_DOCKER_IPV6_SUBNET=fdcc:ad94:bacf:61a3::/64
WG_HOST_ROUTE_CIDR=10.8.0.0/24
WG_HOST_ROUTE_WAIT_SECONDS=90
