# Speech: required only for Azure TTS.
# Create an Azure AI Speech resource, then copy its key and matching region here.
# Never commit a real key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# GitLab Issue: only valid when the current repository is hosted on this self-hosted GitLab.
# GITLAB_BASE_URL must be the trusted instance root and must match the current git origin host.
# The project path is always inferred from the current repository origin.
GITLAB_BASE_URL=
# Set a personal, project, or group access token with the required issue API permissions.
# Never commit a real token.
GITLAB_PRIVATE_TOKEN=

# Speech: required only for ASR.
# Deploy qwen3-asr-openai as needed: https://github.com/Scisaga/qwen3-asr-openai
# Set this to the reachable service base URL; it is not an API key.
# The current speech client does not use an ASR API key.
QWEN_ASR_API_BASE=http://127.0.0.1:12301

# Optional proxy settings used by subtitle-matcher and other network clients
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1
